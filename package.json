{
  "name": "amplify-hope-api",
  "version": "1.7.1",
  "description": "NodeJS API backend for amplify hope website",
  "main": "src/index.ts",
  "author": "Anthony Giannell",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write .",
    "lint": "eslint src",
    "rebuild-db": "docker compose stop db; docker compose rm -f db; docker compose up -d",
    "start": "NODE_OPTIONS='--unhandled-rejections=warn' ts-node src/index.ts",
    "start:dev": "NODE_OPTIONS='--unhandled-rejections=warn' ts-node-dev src/index.ts",
    "test:unit": "NODE_ENV=development ts-mocha '**/*.unit.ts'",
    "typecheck": "tsc --noEmit",
    "version": "echo $npm_package_version"
  },
  "dependencies": {
    "@sentry/node": "^11.4.0",
    "@sentry/profiling-node": "^11.4.0",
    "camelcase-keys": "^7.0.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "ramda": "^0.32.0",
    "resend": "^6.32.1",
    "snakecase-keys": "^8.1.0",
    "stripe": "^17.7.0",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^4.3.11",
    "@types/cors": "^2.8.19",
    "@types/eslint": "^9.6.1",
    "@types/eslint-plugin-prettier": "^3.1.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/ramda": "^0.32.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "chai": "^4.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^11.7.6",
    "prettier": "^3.9.9",
    "ts-mocha": "^10.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=24"
  }
}
